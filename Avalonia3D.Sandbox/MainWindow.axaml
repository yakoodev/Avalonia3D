<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Avalonia3D.Sandbox"
        xmlns:viewModels="clr-namespace:Avalonia3D.Sandbox.ViewModels"
        mc:Ignorable="d"
        x:Class="Avalonia3D.Sandbox.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="Avalonia3D Sandbox"
        Width="1400"
        Height="820">
  <Window.KeyBindings>
    <KeyBinding Gesture="F" Command="{Binding FrameAllCommand}" />
    <KeyBinding Gesture="R" Command="{Binding ResetViewCommand}" />
    <KeyBinding Gesture="Space" Command="{Binding TogglePlayPauseCommand}" />
  </Window.KeyBindings>

  <Grid ColumnDefinitions="420,6,*" Background="#1B1B1D">
    <Border Grid.Column="0"
            MinWidth="320"
            MaxWidth="700"
            Background="#222226"
            Padding="14"
            BorderBrush="#3A3A40"
            BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#2B2B31" CornerRadius="8" Padding="10" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Avalonia3D Sandbox" FontSize="18" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="Быстрые клавиши: F = Frame All, R = Reset, Space = Play/Pause" Foreground="#BDBDC7" FontSize="12" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <TabControl>
          <TabItem Header="Сцены">
            <ScrollViewer>
              <StackPanel Spacing="10" Margin="0,8,0,0">
                <TextBlock Text="Выберите тестовую сцену" Foreground="White" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Scenes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:SceneItemViewModel">
                      <Border Background="#2D2D33" Padding="10" CornerRadius="8" Margin="0,0,0,8">
                        <StackPanel Spacing="6">
                          <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" />
                          <TextBlock Text="{Binding Description}" Foreground="#CFCFCF" TextWrapping="Wrap" />
                          <Button Content="Открыть сцену" Command="{Binding LoadCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Камера">
            <ScrollViewer>
              <StackPanel Spacing="10" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Frame All" Command="{Binding FrameAllCommand}" />
                  <Button Content="Reset" Command="{Binding ResetViewCommand}" />
                  <Button Content="Toggle Mode" Command="{Binding ToggleCameraModeCommand}" />
                </StackPanel>
                <TextBlock Text="Текущий режим камеры:" Foreground="#D6D6D6" />
                <TextBlock Text="{Binding CurrentCameraMode}" Foreground="White" FontWeight="SemiBold" />

                <TextBlock Text="Orbit sensitivity" Foreground="#D6D6D6" />
                <Slider Minimum="0.001" Maximum="0.1" Value="{Binding OrbitSensitivity}" />
                <TextBlock Text="Pan sensitivity" Foreground="#D6D6D6" />
                <Slider Minimum="0.001" Maximum="0.1" Value="{Binding PanSensitivity}" />
                <TextBlock Text="Dolly sensitivity" Foreground="#D6D6D6" />
                <Slider Minimum="0.1" Maximum="10" Value="{Binding DollySensitivity}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Графика / QA">
            <ScrollViewer>
              <StackPanel Spacing="10" Margin="0,8,0,0">
                <TextBlock Text="Профиль качества" FontWeight="SemiBold" Foreground="White" />
                <ComboBox ItemsSource="{Binding QualityPresets}" SelectedItem="{Binding SelectedQualityPreset}" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding ActiveQualitySummary}" Foreground="#D6D6D6" TextWrapping="Wrap" />
                <TextBlock Text="{Binding GraphicsTuningHint}" Foreground="#9FD0FF" TextWrapping="Wrap" />

                <TextBlock Text="Режим шейдера" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,0" />
                <ComboBox ItemsSource="{Binding ShaderModes}" SelectedItem="{Binding SelectedRenderMode}" HorizontalAlignment="Stretch" />
                <Button Content="Применить режим" Command="{Binding SwitchShaderModeCommand}" CommandParameter="{Binding SelectedRenderMode}" HorizontalAlignment="Left" />

                <TextBlock Text="Цвет фона сцены" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,0" />
                <Border Background="#2D2D33" CornerRadius="6" Padding="10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="R" Foreground="#D6D6D6" />
                    <Slider Minimum="0" Maximum="255" Value="{Binding BackgroundRed}" />
                    <TextBlock Text="G" Foreground="#D6D6D6" />
                    <Slider Minimum="0" Maximum="255" Value="{Binding BackgroundGreen}" />
                    <TextBlock Text="B" Foreground="#D6D6D6" />
                    <Slider Minimum="0" Maximum="255" Value="{Binding BackgroundBlue}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Border Width="28" Height="28" CornerRadius="4" BorderBrush="#808080" BorderThickness="1" Background="{Binding BackgroundPreviewBrush}" />
                      <TextBlock Text="{Binding BackgroundHex}" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Text="JSON профиля (импорт/экспорт)" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0" />
                <TextBox Text="{Binding ProfileJsonEditor}" AcceptsReturn="True" TextWrapping="Wrap" Height="180" FontFamily="Consolas" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Применить JSON" Command="{Binding ApplyProfileJsonCommand}" />
                  <Button Content="Сбросить к активному" Command="{Binding ResetProfileJsonCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding ProfileStatusMessage}" Foreground="#C9F7A5" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Анимация">
            <ScrollViewer>
              <StackPanel Spacing="10" Margin="0,8,0,0">
                <TextBlock Text="Список анимаций" Foreground="White" FontWeight="SemiBold" />
                <Border Background="#2D2D33" CornerRadius="6" Padding="8" MaxHeight="180">
                  <ListBox ItemsSource="{Binding AvailableClips}" SelectedItem="{Binding SelectedClipName}" />
                </Border>

                <TextBlock Text="Выбранная анимация" Foreground="#D6D6D6" />
                <ComboBox ItemsSource="{Binding AvailableClips}" SelectedItem="{Binding SelectedClipName}" HorizontalAlignment="Stretch" />
                <CheckBox Content="Loop" IsChecked="{Binding IsLoopEnabled}" Foreground="White" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Speed" Foreground="White" VerticalAlignment="Center"/>
                  <NumericUpDown Minimum="0.1" Maximum="4" Increment="0.1" Value="{Binding PlaybackSpeed}" Width="120"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Play" Command="{Binding PlayClipCommand}" />
                  <Button Content="Pause" Command="{Binding PauseClipCommand}" />
                  <Button Content="Stop" Command="{Binding StopClipCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding ClipStateText}" Foreground="#CFCFCF" TextWrapping="Wrap" />

                <Separator Margin="0,8,0,2" />
                <TextBlock Text="Команды поведения (semantic id)" Foreground="White" FontWeight="SemiBold" />
                <TextBox Text="{Binding BehaviorTargetSemanticId}" Watermark="например: door.main или wheel.front.left" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Open" Command="{Binding OpenSemanticTargetCommand}" />
                  <Button Content="Close" Command="{Binding CloseSemanticTargetCommand}" />
                  <Button Content="Toggle" Command="{Binding ToggleSemanticTargetCommand}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Border>

    <GridSplitter Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="#3E3E45"
                  ResizeDirection="Columns"
                  ShowsPreview="True" />

    <Grid Grid.Column="2">
      <Grid>
        <Border Background="Black">
          <local:SandboxModel3DControl x:Name="Viewport" />
        </Border>
        <Border x:Name="InputOverlay" Background="Transparent" IsHitTestVisible="True" />
      </Grid>
      <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Background="#88000000" Padding="10" CornerRadius="6">
        <StackPanel>
          <TextBlock Text="{Binding CurrentSceneTitle}" Foreground="White" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ImportStatusText}" Foreground="#FFD36B" FontSize="11" MaxWidth="600" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ActiveQualitySummary}" Foreground="#D0D0D0" FontSize="11" MaxWidth="600" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
