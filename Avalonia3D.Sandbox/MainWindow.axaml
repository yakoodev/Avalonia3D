<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Avalonia3D.Sandbox"
        xmlns:viewModels="clr-namespace:Avalonia3D.Sandbox.ViewModels"
        mc:Ignorable="d"
        x:Class="Avalonia3D.Sandbox.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="Avalonia3D Sandbox"
        Width="1200"
        Height="720">
  <Window.KeyBindings>
    <KeyBinding Gesture="F" Command="{Binding FrameAllCommand}" />
    <KeyBinding Gesture="R" Command="{Binding ResetViewCommand}" />
    <KeyBinding Gesture="Space" Command="{Binding TogglePlayPauseCommand}" />
  </Window.KeyBindings>

  <Grid ColumnDefinitions="280,*" Background="#1E1E1E">
    <Border Grid.Column="0" Background="#252526" Padding="16">
      <ScrollViewer>
        <StackPanel Spacing="12">
          <TextBlock Text="Тестовые сцены" FontSize="18" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="Камера" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Frame" Command="{Binding FrameAllCommand}" />
            <Button Content="Reset" Command="{Binding ResetViewCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Mode:" Foreground="White" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CurrentCameraMode}" Foreground="#CFCFCF" VerticalAlignment="Center" />
            <Button Content="Toggle" Command="{Binding ToggleCameraModeCommand}" />
          </StackPanel>
          <TextBlock Text="Orbit sensitivity" Foreground="White" />
          <Slider Minimum="0.001" Maximum="0.1" Value="{Binding OrbitSensitivity}" />
          <TextBlock Text="Pan sensitivity" Foreground="White" />
          <Slider Minimum="0.001" Maximum="0.1" Value="{Binding PanSensitivity}" />
          <TextBlock Text="Dolly sensitivity" Foreground="White" />
          <Slider Minimum="0.1" Maximum="10" Value="{Binding DollySensitivity}" />

          <TextBlock Text="Режим шейдера" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,8,0,0" />
          <ComboBox ItemsSource="{Binding ShaderModes}"
                    SelectedItem="{Binding SelectedRenderMode}"
                    HorizontalAlignment="Stretch" />
          <Button Content="Применить режим"
                  Command="{Binding SwitchShaderModeCommand}"
                  CommandParameter="{Binding SelectedRenderMode}"
                  HorizontalAlignment="Left" />
          <TextBlock Text="Анимация" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,8,0,0" />
          <ComboBox ItemsSource="{Binding AvailableClips}"
                    SelectedItem="{Binding SelectedClipName}"
                    HorizontalAlignment="Stretch" />
          <CheckBox Content="Loop" IsChecked="{Binding IsLoopEnabled}" Foreground="White" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Speed" Foreground="White" VerticalAlignment="Center"/>
            <NumericUpDown Minimum="0.1" Maximum="4" Increment="0.1" Value="{Binding PlaybackSpeed}" Width="120"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Play" Command="{Binding PlayClipCommand}" />
            <Button Content="Pause" Command="{Binding PauseClipCommand}" />
            <Button Content="Stop" Command="{Binding StopClipCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding ClipStateText}" Foreground="#CFCFCF" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Scenes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModels:SceneItemViewModel">
                <Border Background="#2D2D30" Padding="12" CornerRadius="6">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding Description}" Foreground="#CFCFCF" TextWrapping="Wrap" />
                    <Button Content="Открыть" Command="{Binding LoadCommand}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid Grid.Column="1">
      <Border Background="Black">
        <local:SandboxModel3DControl x:Name="Viewport" />
      </Border>
      <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Background="#66000000" Padding="8" CornerRadius="4">
        <TextBlock Text="{Binding CurrentSceneTitle}" Foreground="White" />
      </Border>
    </Grid>
  </Grid>
</Window>
